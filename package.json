{
  "name": "cc-extension-cue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev",
    "lint": "eslint . --max-warnings=0",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build:ci": "turbo run build --filter='!@bsgames/oms-plugin-cue'",
    "test:ci": "turbo run test --filter='!@bsgames/oms-plugin-cue' && pnpm --filter @bsgames/oms-plugin-cue exec vitest run",
    "build:release": "turbo run build --filter=@bsgames/cue --filter=@bsgames/cue-compiler --filter=@bsgames/cue-control-schema --filter=@bsgames/cue-style-schema --filter=@bsgames/cue-language-service",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:release && changeset publish",
    "prelint": "pnpm build:release"
  },
  "devDependencies": {
    "@bsgames/cue-workflow": "workspace:*",
    "@changesets/cli": "^2.31.1",
    "@shrinktofit/eslint-config": "^0.0.16",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.5.0",
    "turbo": "^2.9.12",
    "typescript": "catalog:",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
