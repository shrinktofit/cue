CCEffect %{
  techniques:
  - name: default
    passes:
    - vert: cue-text-vs:vert
      frag: cue-text-fs:frag
      properties:
        mainTexture: { value: white }
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
}%

CCProgram cue-text-vs %{
  precision highp float;

  #include <builtin/uniforms/cc-local>
  #include <builtin/uniforms/cc-global>

  in vec2 a_position;
  in vec2 a_texCoord;

  out vec2 v_texCoord;

  vec4 vert() {
    v_texCoord = a_texCoord;
    return cc_matProj * (cc_matView * cc_matWorld) * vec4(a_position, 0.0, 1.0);
  }
}%

CCProgram cue-text-fs %{
  precision highp float;
  #include <legacy/output>

  in vec2 v_texCoord;

  uniform sampler2D mainTexture;

  vec4 frag() {
    return texture(mainTexture, v_texCoord);
  }
}%
