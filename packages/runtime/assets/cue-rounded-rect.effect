CCEffect %{
  techniques:
  - name: default
    passes:
    - vert: cue-rounded-rect-vs:vert
      frag: cue-rounded-rect-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
}%

CCProgram cue-rounded-rect-vs %{
  precision highp float;

  #include <builtin/uniforms/cc-local>
  #include <builtin/uniforms/cc-global>

  in vec2 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  in vec2 a_texCoord1;
  in vec4 a_texCoord2;

  out vec2 v_texCoord;
  out vec4 v_color;
  out vec2 v_size;
  out vec4 v_radii;

  vec4 vert() {
    v_texCoord = a_texCoord;
    v_color = a_color;
    v_size = a_texCoord1;
    v_radii = a_texCoord2;
    return cc_matProj * (cc_matView * cc_matWorld) * vec4(a_position, 0.0, 1.0);
  }
}%

CCProgram cue-rounded-rect-fs %{
  precision highp float;
  #include <legacy/output>

  in vec2 v_texCoord;
  in vec4 v_color;
  in vec2 v_size;
  in vec4 v_radii;

  float cornerRadius(vec2 position) {
    if (position.x < 0.0) {
      return position.y < 0.0 ? v_radii.w : v_radii.x;
    }
    return position.y < 0.0 ? v_radii.z : v_radii.y;
  }

  vec4 frag() {
    vec2 position = (v_texCoord - vec2(0.5)) * v_size;
    float radius = cornerRadius(position);
    vec2 distanceVector = abs(position) - v_size * 0.5 + vec2(radius);
    float distance = length(max(distanceVector, vec2(0.0)))
      + min(max(distanceVector.x, distanceVector.y), 0.0)
      - radius;
    float antialiasWidth = 0.75;
    float coverage = 1.0 - smoothstep(-antialiasWidth, antialiasWidth, distance);
    return vec4(v_color.rgb, v_color.a * coverage);
  }
}%
